# sso.dgov.mn — Цахим Засгийн нэвтрэлт.
#
# Жинхэнэ файл нь серверийн /opt/sso-dgov-mn/deploy/.env бөгөөд нууц
# утгуудтай тул энд хэзээ ч commit хийгдэхгүй (.gitignore). Энэ нь тэр
# файлын хэлбэр.
#
# docker-compose.yml нь энэ файлыг хоёр янзаар уншина: `${...}` орлуулга
# (портууд, нууц үг) ба backend-ийн `env_file` — сүүлийнх нь энд байгаа бүх
# мөрийг контейнер рүү дамжуулна. Тэгэхээр цөмийн ямар ч тохиргоог энд
# нэмж болно, compose-ыг өөрчлөх шаардлагагүй.

# ------------------------------------------------------------------ энэ стек
# Хажууд нь open.dgov.mn (dgov_nexus_*, 5434 / 6381 / 8082 / 3008) ажиллаж
# байна. Энэ стекийн портууд compose дотор тогтмол: 5438 postgres,
# 8096 backend, 3016 бүрхүүл — бүгд зөвхөн loopback дээр.
SSO_DGOV_POSTGRES_PASSWORD=

# Локал баригдсан образ. Нийтлэгдсэн образ байхгүй: цөм нь go.mod-оор
# татагддаг ч бинар нь энэ репогоос баригдана — deploy.sh-г үз.
IMAGE=sso-dgov:latest
# Бүрхүүл нь цөмийн нийтэлсэн образ, тодорхой commit дээр түгжигдсэн.
# `latest` биш байх нь: «өчигдөр ажиллаж байсан» гэдэг нь хувилбар байх
# ёстой. Энэ бол хажуугийн open.dgov.mn-ий ажиллуулж байгаа яг тэр бүрхүүл.
WEB_IMAGE=ghcr.io/gerege-systems/open-gerege-nexus/frontend:d135c8871b0e5c0f99a25c0b316979d2e0c5f76c

# --------------------------------------------------------------------- домэйн
PUBLIC_ORIGIN=https://sso.dgov.mn

# --------------------------------------------------------------- landing page
# Энэ суулгацын өөрийн гарын авлага — цэсний «Баримт бичиг». Хоёр домэйныг
# хамтад нь тайлбарладаг тул open-dgov-mn репогийн Pages дээр амьдарна.
BRAND_DOCS_URL=https://gerege-systems.github.io/open-dgov-mn/

# Энэ бол нэвтрэлтийн провайдер. Архитектур, бизнес аппын каталог,
# платформын суурь гурав нь open.dgov.mn-ий хийдэг маргаан; энд тэднийг
# давтах нь хоёр газар үнэн байлгах шаардлага, бас худал зар.
#
# Үгсийг нь brand/copy.json дарж бичнэ (BRAND_COPY_FILE — compose дотор
# тогтмол). Аль нь ч цөмийн шинэ образыг шаардана: LANDING_SECTIONS ба
# BRAND_DOCS_URL хоёр open-gerege-nexus#150-аар нэмэгдсэн.
LANDING_SECTIONS=hero trust technology capabilities

# ------------------------------------------------------ энэ бүтээгдэхүүнийх
# base64, 32 байт: `openssl rand -base64 32`.
# Federation-ы client secret ба SCIM токеныг шифрлэнэ. Байхгүй бол
# бүтээгдэхүүн асна, харин итгэмжлэл хадгалах бичилт татгалзана. Солих нь
# хадгалагдсан итгэмжлэлүүд задрахаа болино гэсэн үг.
SSO_SECRET_KEY=

# ---------------------------------------------------------- нэвтрэлт: провайдер
# Энэ суулгац бол identity-гийн ЭХ СУРВАЛЖ. SSO_ISSUER-ыг compose нь
# PUBLIC_ORIGIN-оос авна — тусад нь бичих зүйл алга.
#
# Production дээр үүнгүйгээр цөм асахаас татгалзана. Платформын өөрийн
# `gerege-dev-portal` клиентийн нууц.
SSO_DEFAULT_CLIENT_SECRET=
# Тэр клиентийн эзэн тенант. Байхгүй тенантад клиент үүсгэхгүй, алгасна.
SSO_DEFAULT_CLIENT_TENANT=dgov

# Redirect-ийн зөвшөөрөгдсөн хостууд. Яг таг тааралдана — дэд домэйн
# өвлөгдөхгүй, тиймээс клиент нэмэгдэх бүрт энэ мөр уртсана.
OAUTH_REDIRECT_HOSTS=open.dgov.mn

# ---------------------------------------------------------------------- брэнд
# Хүсэлт бүр дээр уншигдана — образ биш, тохиргоо. BRAND_NAME нь landing
# page-ийн {brand} орлуулга ч мөн — copy.json доторх өгүүлбэрүүд түүнийг
# нэрлэдэг тул богиносгох нь хоёр газарт харагдана.
BRAND_NAME=Засгийн газрын нэгдсэн нэвтрэлт
BRAND_SHORT_NAME=Нэгдсэн нэвтрэлт
BRAND_DESCRIPTION=Төрийн үйлчилгээний нэгдсэн нэвтрэлт
BRAND_THEME_COLOR=#0050b0
# deploy/brand/ доторх файлууд, nginx-ээр /brand/… доор. Толгойн лого ба
# табын favicon хоёр нэг зураг: тусад нь зурсан хоёр байхгүй бол нэгийг нь
# хоёр газар зааж болно гэж цөм өөрөө хэлдэг (frontend/lib/brand.ts).
BRAND_LOGO_URL=/brand/gov_icon.png
BRAND_ICON_URL=/brand/gov_icon.png
# Зориуд хоосон. Maskable icon бол хэмжээ өөрчлөх ажил биш: Android дугуй
# эсвэл squircle огтолдог тул булан нь тайрагдана. Хоосон бол maskable
# бичлэг огт нийтлэгдэхгүй, launcher энгийнийг нь өөрөө маскална — ижил
# зураг, харагдахаар тайрагдсан нь чимээгүй буруугаас дээр.
BRAND_MASKABLE_ICON_URL=

# eID-ийн харилцах цонх ч мөн энэ байрлуулалтын нэрийг хэлнэ. Хоосон орхивол
# иргэн утсан дээрээ "Gerege Nexus" гэж уншина.
EID_RP_NAME=Цахим Засаг
EID_DISPLAY_TEXT=Цахим Засагт нэвтрэх
# Жинхэнэ eID-ийн RP итгэмжлэл. Хоосон бол eID-ийн товч ажиллахгүй —
# нууц үгээр нэвтрэх зам үлдэнэ.
EID_RP_UUID=
EID_RP_SECRET=
EID_MOCK_MODE=false

# ------------------------------------------------------------------ бусад
DEMO_MODE=false
